{
  "name": "vr-showroom",
  "version": "1.0.0",
  "description": "VR Showroom - Telegram Bot and Mini App for Chinese factory goods",
  "private": true,
  "workspaces": [
    "bot",
    "mini-app"
  ],
  "scripts": {
    "bot:dev": "npm run dev --workspace=bot",
    "bot:start": "npm run start --workspace=bot",
    "app:dev": "npm run dev --workspace=mini-app",
    "app:build": "npm run build --workspace=mini-app",
    "dev": "concurrently 'npm run bot:dev' 'npm run app:dev'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}